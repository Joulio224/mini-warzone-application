{
  "name": "mini-warzone",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "firebase": "^11.8.1",
    "socket.io-client": "^4.8.3",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "fr.miniwarzone.game",
    "productName": "Mini Warzone",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mini Warzone"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Joulio224",
        "repo": "mini-warzone-application",
        "releaseType": "release"
      }
    ]
  }
}
