{
  "name": "bulletgrounds",
  "version": "0.1.15",
  "private": true,
  "author": "Joulio224",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win nsis --publish never",
    "electron:store": "npm run build && electron-builder --win appx --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "firebase": "^11.8.1",
    "socket.io-client": "^4.8.3",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^5.4.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "fr.miniwarzone.game",
    "productName": "BulletGrounds",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "BulletGrounds-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BulletGrounds"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Joulio224",
        "repo": "BulletGrounds",
        "releaseType": "release"
      }
    ],
    "appx": {
      "identityName": "Joulio224.BulletGrounds",
      "publisher": "CN=F3F2D387-9964-4AD8-B241-80B3B77492BC",
      "publisherDisplayName": "Joulio224",
      "displayName": "BulletGrounds",
      "applicationId": "BulletGrounds",
      "languages": [
        "fr-FR"
      ]
    }
  }
}
